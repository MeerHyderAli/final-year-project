# AutoParts AI — environment configuration
#
# Copy to `.env` and edit. Nothing here is required: the project runs fully offline
# on the local model with no keys at all. This file exists so that turning on the
# optional cloud vision provider is a two-line change.

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (Express API) — port 4000
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# Where the Python vision service lives.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=20000

# Below this confidence the API refuses to assert a category and asks the user for
# a part number or vehicle instead. Do not lower this to make the demo look better.
MIN_CONFIDENCE=0.55

# Upload limit per image, bytes (default 8 MB).
UPLOAD_MAX_BYTES=8388608

# Optional. Leave unset to serve from the JSON catalogue in data/.
# When set, the store mirrors into MongoDB on boot and reads from it.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=autoparts_ai


# ─────────────────────────────────────────────────────────────────────────────
# VISION SERVICE (FastAPI) — port 8000
# ─────────────────────────────────────────────────────────────────────────────
MODEL_PATH=ai-service/models/part_classifier.pt
MAX_UPLOAD_BYTES=8388608

# Which vision backend serves POST /predict.
#
#   local      (default) the trained PyTorch model. Free, offline, private.
#              Scores 0.969 in-domain / 0.258 on real photos — see
#              docs/DATASET-AND-MODEL.md. Fit for a demo, not for real users.
#
#   openai | gemini | anthropic
#              a frontier vision model. Far better on real photographs, which is
#              exactly the weakness of the local model. Trade-offs:
#                + identifies real parts properly
#                - costs roughly USD 0.001–0.01 per image
#                - needs internet; the offline demo stops working
#                - the user's photo leaves the device (disclose this to users)
#                - "confidence" becomes a self-report, not a calibrated probability
#
#              IMPORTANT: this does NOT let the AI assert fitment. A vision model
#              returns a CATEGORY only. Fitment still needs a part-number or
#              vehicle-catalogue match. The safety architecture is unchanged.
VISION_PROVIDER=local

# API key. Or use the provider's own variable (OPENAI_API_KEY / GEMINI_API_KEY /
# GOOGLE_API_KEY / ANTHROPIC_API_KEY) — those are picked up automatically.
# VISION_API_KEY=

# Optional overrides.
# VISION_MODEL=gpt-4o                  # default: gpt-4o | gemini-2.0-flash | claude-sonnet-4-20250514
# VISION_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible gateway
# VISION_TIMEOUT=25


# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite dev server) — port 5173
# ─────────────────────────────────────────────────────────────────────────────
# Where the dev server proxies /api. Only change this to point at a remote API.
# VITE_API_TARGET=http://127.0.0.1:4000
