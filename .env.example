# AutoParts AI — environment configuration
#
# Copy to `.env` and edit, or just export the two variables you need.
#
# THE ONLY THING YOU NEED FOR AI:
#     VISION_PROVIDER=gemini
#     VISION_API_KEY=your-key
#
# No model training, no image dataset, no GPU. Get a free Gemini key at
# https://aistudio.google.com/apikey and verify it with:
#     bash scripts/check-gemini.sh

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (Express API) — port 4000
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# Where the Python vision service lives.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=20000

# Below this confidence the API refuses to assert a category and asks the user for
# a part number or vehicle instead. Do not lower this to make the demo look better.
MIN_CONFIDENCE=0.55

# Upload limit per image, bytes (default 8 MB).
UPLOAD_MAX_BYTES=8388608

# Optional. Leave unset to serve from the JSON catalogue in data/.
# When set, the store mirrors into MongoDB on boot and reads from it.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=autoparts_ai


# ─────────────────────────────────────────────────────────────────────────────
# IDENTIFICATION SERVICE (FastAPI) — port 8000
# ─────────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=8388608
# Only read when the local fallback model is installed (see requirements-local.txt).
MODEL_PATH=ai-service/models/part_classifier.pt

# Which identification engine serves POST /predict, /ocr and /describe.
#
#   gemini     (default) Google's vision model. Needs internet + an API key.
#              Handles photos, label OCR and text descriptions. No training needed.
#   openai     GPT-4o, same three capabilities.
#   anthropic  Claude, same three capabilities.
#   local      the optional offline checkpoint. Free and private, but scores 0.258
#              on real photographs — see docs/DATASET-AND-MODEL.md. Only useful for
#              an offline demo or the ablation study.
#
# IMPORTANT, whichever you choose: the AI returns a CATEGORY only. It can never
# assert that a part FITS a vehicle. Fitment comes from a part-number or
# vehicle-catalogue match in the Express API. An API key is not a shortcut around
# that rule.
VISION_PROVIDER=gemini

# API key. Or use the provider's own variable — GEMINI_API_KEY / GOOGLE_API_KEY /
# OPENAI_API_KEY / ANTHROPIC_API_KEY are all picked up automatically.
# VISION_API_KEY=

# Optional overrides.
# VISION_MODEL=gemini-2.5-flash    # gemini-2.5-flash | gemini-2.0-flash | gpt-4o | claude-sonnet-4-20250514
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta   # for a proxy or a mock
# VISION_TIMEOUT=30
# VISION_RETRIES=2                 # retries on timeouts and 429/5xx


# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite dev server) — port 5173
# ─────────────────────────────────────────────────────────────────────────────
# Where the dev server proxies /api. Only change this to point at a remote API.
# VITE_API_TARGET=http://127.0.0.1:4000
